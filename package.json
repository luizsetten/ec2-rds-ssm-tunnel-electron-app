{
  "name": "app-connections-rds",
  "version": "1.0.0",
  "description": "Gerenciador de Conexões AWS via SSM",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc &&  electron-builder",
    "dev": "tsc . && electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.621.0",
    "@aws-sdk/client-sso": "^3.621.0",
    "@aws-sdk/client-sso-oidc": "^3.621.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.2",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.app.app",
    "productName": "app-connections-rds",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "renderer/**/*",
      "utils/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "connections.json",
        "to": "connections.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
